#!/usr/bin/env python3
"""Fake llama-server: /health, /tokenize, /completion with timings, /v1/chat/completions.
For selftest.sh only. Answers bench tasks with the reference answer; a model file containing 'weak' answers garbage."""
import argparse, json, os, sys, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
ROOT = os.environ.get("NH_ROOT") or os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
sys.path.insert(0, ROOT)
from bench.tasks import load_tasks
p = argparse.ArgumentParser(); p.add_argument("-m"); p.add_argument("--host"); p.add_argument("--port", type=int)
a, _ = p.parse_known_args()
weak = "weak" in a.m
REF = {t.prompt: t.reference() for t in load_tasks()}
vram_file = os.environ["FAKE_VRAM"]
mib = os.path.getsize(a.m) // 2**20 + 500
if "crash" in a.m: sys.exit(3)
open(vram_file, "w").write(f"{os.getpid()} {mib // 2}")
time.sleep(1)
open(vram_file, "w").write(f"{os.getpid()} {mib}")
junk = bytearray(50 * 2**20)  # touch RAM so VmHWM grows
class H(BaseHTTPRequestHandler):
    def log_message(self, *x): pass
    def _send(self, obj, code=200):
        b = json.dumps(obj).encode(); self.send_response(code)
        self.send_header("Content-Type", "application/json"); self.send_header("Content-Length", str(len(b)))
        self.end_headers(); self.wfile.write(b)
    def do_GET(self):
        self._send({"status": "ok"})
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        if self.path == "/tokenize":
            return self._send({"tokens": list(range(len(body["content"].split()) * 2))})
        if self.path == "/completion":
            open(vram_file, "w").write(f"{os.getpid()} {mib + 300}")  # KV cache grows during inference
            return self._send({"content": "x", "timings": {"prompt_per_second": 900.0 if not weak else 1500.0,
                                                           "predicted_per_second": 40.0 if not weak else 70.0}})
        if self.path == "/v1/chat/completions":
            prompt = body["messages"][0]["content"]
            text = "не знаю" if weak and hash(prompt) % 3 else REF.get(prompt, "?")
            return self._send({"model": "fake", "choices": [{"message": {"content": text}}],
                               "usage": {"prompt_tokens": 100, "completion_tokens": 50}})
        self._send({"error": "no"}, 404)
ThreadingHTTPServer((a.host, a.port), H).serve_forever()
