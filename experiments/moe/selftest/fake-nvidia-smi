#!/usr/bin/env python3
# Fake nvidia-smi for selftest.sh: reports the memory that fake-llama-server writes to $FAKE_VRAM.
import os, sys
q = next(x for x in sys.argv if x.startswith("--query"))
try: pid, mib = open(os.environ["FAKE_VRAM"]).read().split()
except Exception: pid, mib = "0", "0"
alive = pid != "0" and os.path.exists(f"/proc/{pid}")
used = int(mib) if alive else 0
if "compute-apps" in q:
    if alive: print(f"{pid}, {used}")
elif "name" in q: print("Fake RTX 4090, 24564 MiB")
else: print(1200 + used)  # 1200 MiB used by the desktop
